# Downloaded images (SystemRescue ISO and similar)
downloads/
*.iso
*.img

# SSH keys for the rescue session: never commit
keys/
*.pem

# Data copied from the faulty PC (crash dumps, event logs, personal files)
collected/
*.dmp
*.evtx

# USB build staging
build/

# skill-creator eval runs
.claude/skills/*-workspace/

# Case logs: one per rescued PC, local only (the repo holds the skill and its tools)
cases/
